{
  "name": "@freelensapp/kamaji-extension",
  "version": "2.0.0-0",
  "description": "Kamaji extension",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freelensapp/freelens-kamaji-extension.git",
    "directory": "."
  },
  "main": "out/main/index.js",
  "renderer": "out/renderer/index.js",
  "files": [
    "out/**/*"
  ],
  "engines": {
    "node": ">= 24.0.0",
    "freelens": "^2.0.0"
  },
  "copyright": "© 2025-2026 Freelens Authors",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Freelens Authors",
    "email": "freelens@freelens.app"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "biome": "pnpm dlx @biomejs/biome@2.6.3",
    "biome:check": "corepack pnpm biome check",
    "biome:fix": "corepack pnpm biome check --fix",
    "prebuild": "corepack pnpm typecheck",
    "build": "electron-vite build",
    "bump-version": "corepack pnpm version --no-commit-hooks --no-git-tag-version",
    "clean": "corepack pnpm dlx rimraf@6.0.1 binaries dist static/build",
    "clean:node_modules": "corepack pnpm dlx rimraf@6.0.1 node_modules",
    "knip": "pnpm dlx knip@6.41.0 --dependencies --files --no-gitignore --no-config-hints",
    "knip:development": "corepack pnpm knip",
    "knip:production": "corepack pnpm knip --production --strict",
    "lint": "corepack pnpm biome:check",
    "lint:fix": "corepack pnpm biome:fix",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@freelensapp/extensions": "^2.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "kamaji",
    "control-plane",
    "tenant",
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens"
  ],
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
